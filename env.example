# 이 파일을 backend/.env 로 복사한 뒤 실제 값을 채우세요. .env는 절대 git에 커밋하지 마세요.
# (backend/.gitignore에 .env가 등록되어 있는지 반드시 다시 확인)

# 한국투자증권 실전투자 Open API (KIS Developers에서 발급)
KIS_APPKEY=실제_발급받은_APPKEY
KIS_APPSECRET=실제_발급받은_APPSECRET
KIS_CANO=계좌번호_앞8자리
KIS_ACNT_PRDT_CD=계좌번호_뒤2자리(예:01)
KIS_MODE=prod

# 종가배팅 뉴스 모멘텀 조건용 (선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 종가배팅 공매도/대주주 리스크 조건용 (선택)
DART_API_KEY=

# 프런트엔드(HTML)를 배포한 도메인만 허용하려면 지정 (미설정 시 전체 허용)
ALLOWED_ORIGIN=*

# 감시 유니버스 크기 (거래대금+등락률 상위 몇 종목을 모을지, 기본 100)
UNIVERSE_LIMIT=100
# 그중 실제로 CASE/종가배팅 상세평가할 종목 수 (기본 30 — KIS 호출 제한/타임아웃 보호)
SCAN_LIMIT=30

PORT=5000
